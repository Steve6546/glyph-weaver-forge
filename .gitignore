# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Environment files: a real value never enters the repository.
# This covers the local, preview and production variants a developer or a
# build step may create (.env.local, .env.production, ...).
.env
.env.*
*.env

# Templates are the opposite case: they document variable names and must
# stay tracked, so they are exempted after the rules above.
!.env.example
!.env.sample
!.env.template
